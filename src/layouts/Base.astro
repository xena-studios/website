---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import External from "../components/External.astro";
import fontLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results, with no canonical or og:url (the 404 page). */
  noindex?: boolean;
}

const {
  title = "Xena Studios: game servers, and the tools to run them",
  description = "Xena Studios builds open-source software for game servers on machines you own (Raptor, NeoSkript, Minecraft plugins), and runs Minecraft servers of its own: MostWanted and Airfields.",
  noindex = false,
} = Astro.props;

// build.format "file" makes the pathname /index.html or /<page>.html; the
// canonical address has neither, matching the sitemap and trailingSlash "never".
const path = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(path, Astro.site);
const og = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();

// The main sections. The current one is marked for assistive tech and styled.
const nav = [
  { href: "/tools", text: "Tools" },
  { href: "/servers", text: "Servers" },
  { href: "/about", text: "About", optional: true },
  { href: "/contact", text: "Contact" },
];
const section = nav.find((n) => path === n.href || path.startsWith(`${n.href}/`))?.href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#06080D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xena Studios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="XENA STUDIOS over a planet horizon: game servers, and the tools to run them." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="home" href="/" aria-label="Xena Studios, home">
          <Logo class="logo" />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li class={n.optional ? "optional" : undefined}>
                  <a href={n.href} aria-current={section === n.href ? "page" : undefined}>{n.text}</a>
                </li>
              ))
            }
            <li class="optional"><a href="https://github.com/xena-studios" rel="me"><External>GitHub</External></a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-studio">
          <Logo name="xena" class="foot-logo" />
          <p class="label">© {year} Xena Studios</p>
        </div>
        <nav class="foot-cols" aria-label="Footer">
          <div>
            <h2 class="label">Tools</h2>
            <ul>
              <li><a href="https://raptorpanel.net"><External>Raptor</External></a></li>
              <li><a href="https://neoskript.dev"><External>NeoSkript</External></a></li>
              <li><a href="https://docs.xenastudios.co">Plugin <External>docs</External></a></li>
            </ul>
          </div>
          <div>
            <h2 class="label">Servers</h2>
            <ul>
              <li><a href="https://mostwantedmc.com"><External>MostWanted</External></a></li>
              <li><a href="https://airfieldsmc.com"><External>Airfields</External></a></li>
            </ul>
          </div>
          <div>
            <h2 class="label">Studio</h2>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="https://github.com/xena-studios"><External>GitHub</External></a></li>
              <li><a href="https://modrinth.com/organization/xena-studios"><External>Modrinth</External></a></li>
            </ul>
          </div>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4rem;
  }

  .home {
    display: block;
    color: var(--text);
    padding-block: var(--s-3);
  }

  .home :global(.logo) {
    height: 0.8125rem;
    width: auto;
  }

  nav ul {
    display: flex;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
  }

  nav a {
    display: inline-block;
    padding-block: var(--s-2);
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.6em;
  }

  @media (max-width: 40rem) {
    .optional {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .home :global(.logo) {
      height: 0.6875rem;
    }

    nav ul {
      gap: var(--s-3);
      font-size: var(--t-label);
    }
  }

  .site-footer {
    padding-block: var(--s-7) var(--s-7);
    border-top: 1px solid var(--rule);
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-6);
    align-items: start;
  }

  .foot-studio {
    display: grid;
    gap: var(--s-3);
  }

  .foot :global(.foot-logo) {
    height: 0.75rem;
    width: auto;
    color: var(--text);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(8rem, auto));
    gap: var(--s-6);
  }

  .foot-cols h2 {
    margin-bottom: var(--s-3);
    font-weight: 400;
  }

  .foot-cols ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
  }

  .foot-cols a {
    color: var(--muted);
  }

  .foot-cols a:hover {
    color: var(--text);
  }

  @media (max-width: 48rem) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
