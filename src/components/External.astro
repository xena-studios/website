---
// The site's one icon: an outbound arrow for links that leave xenastudios.co.
// Drawn at the text's cap height in currentColor, hidden from screen readers
// (the link text names the destination).
---
<svg class="external" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
  <path d="M3.5 2.75h5.75v5.75M9.25 2.75 2.75 9.25" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
</svg>

<style>
  .external {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.4em;
    vertical-align: 0.05em;
    opacity: 0.7;
    transition:
      transform 200ms var(--ease),
      opacity 200ms var(--ease);
  }

  :global(a:hover) > .external,
  :global(a:focus-visible) > .external {
    opacity: 1;
    transform: translate(0.08em, -0.08em);
  }
</style>
