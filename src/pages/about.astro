---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Principles from "../components/sections/Principles.astro";
import ContactCta from "../components/ContactCta.astro";
import External from "../components/External.astro";

// What's open and what isn't, so nobody has to guess.
const work = [
  { name: "Raptor", kind: "Tool", licence: "AGPL-3.0", href: "https://github.com/xena-studios/raptor" },
  { name: "NeoSkript", kind: "Tool", licence: "GPL-3.0-only", href: "https://github.com/xena-studios/neoskript" },
  { name: "xUtilities, zChat, xLimbo", kind: "Plugins", licence: "GPL-3.0-only", href: "https://github.com/xena-studios/plugins" },
  { name: "MostWanted, Airfields", kind: "Servers", licence: "Private. Their resource packs are public.", href: null },
  { name: "Brand and this website", kind: "Studio", licence: "Public to read, all rights reserved", href: "https://github.com/xena-studios/brand" },
];
---
<Base
  title="About · Xena Studios"
  description="Xena Studios builds the software game servers run on, the plugins that run on them, and Minecraft servers of its own. How we work, and what's open source."
>
  <PageHero kicker="About" title="A studio for game servers.">
    Xena Studios builds the software that runs game servers, the plugins that run on them, and Minecraft servers of its
    own. The tools are for anyone who runs a server; the servers are for anyone who wants to play.
  </PageHero>

  <Principles />

  <section class="open section" aria-labelledby="open-title">
    <div class="wrap">
      <h2 id="open-title">What's open</h2>
      <p class="lead">
        Everything we ship for other people to run is open source. Our own servers aren't: they're games, and what makes
        them fun is ours to keep.
      </p>
      <dl class="open-list">
        {
          work.map((w) => (
            <div>
              <dt>
                {w.href ? <a href={w.href}><External>{w.name}</External></a> : w.name}
              </dt>
              <dd class="label">{w.kind}</dd>
              <dd>{w.licence}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="elsewhere section" aria-labelledby="elsewhere-title">
    <div class="wrap">
      <h2 id="elsewhere-title">Find us elsewhere</h2>
      <ul class="project-links">
        <li><a href="https://github.com/xena-studios" rel="me"><External>GitHub</External></a></li>
        <li><a href="https://modrinth.com/organization/xena-studios"><External>Modrinth</External></a></li>
        <li><a href="https://github.com/xena-studios/brand">Logos and colours: the <External>brand repo</External></a></li>
      </ul>
    </div>
  </section>

  <ContactCta idPrefix="about-cta" />
</Base>

<style>
  .open-list {
    margin: var(--s-7) 0 0;
    border-top: 1px solid var(--rule);
  }

  .open-list > div {
    display: grid;
    grid-template-columns: minmax(0, 5fr) 8rem minmax(0, 6fr);
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .open-list dt {
    font-weight: 600;
  }

  .open-list dd {
    margin: 0;
  }

  .open-list dd:last-child {
    color: var(--muted);
  }

  @media (max-width: 44rem) {
    .open-list > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
