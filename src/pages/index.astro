---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Horizon from "../components/Horizon.astro";
import External from "../components/External.astro";
import Principles from "../components/sections/Principles.astro";
import ContactCta from "../components/ContactCta.astro";
import consoleShot from "../assets/raptor/console-dark.png";
import mostwantedKeyArt from "../brand/mostwanted/key-art.png";
import airfieldsKeyArt from "../brand/airfields/key-art.png";
import raptorIcon from "../brand/icons/raptor.png";
import neoskriptIcon from "../brand/icons/neoskript.png";
import mostwantedIcon from "../brand/icons/mostwanted.png";
import airfieldsIcon from "../brand/icons/airfields.png";

// The row of marks under the hero: everything we make, each in its own tile.
const marks = [
  { name: "Raptor", icon: raptorIcon, href: "/tools#raptor" },
  { name: "NeoSkript", icon: neoskriptIcon, href: "/tools#neoskript" },
  { name: "MostWanted", icon: mostwantedIcon, href: "/servers#mostwanted" },
  { name: "Airfields", icon: airfieldsIcon, href: "/servers#airfields" },
];

const tools = [
  { name: "Raptor", what: "Runs game servers on any Linux box you own or rent, with no panel to host.", href: "/tools#raptor" },
  { name: "NeoSkript", what: "A drop-in replacement for Skript. Your scripts run unchanged, only faster.", href: "/tools#neoskript" },
  { name: "Plugins", what: "xUtilities, zChat and xLimbo: small plugins for Paper that each do one job.", href: "/tools#plugins" },
];

const servers = [
  { name: "MostWanted", what: "Cops vs. prisoners", art: mostwantedKeyArt, href: "/servers#mostwanted", alt: "MostWanted's key art: its block wordmark over a pixel desert at sunset." },
  { name: "Airfields", what: "Sky-mining PvP", art: airfieldsKeyArt, href: "/servers#airfields", alt: "Airfields' winter key art: the gold wordmark with snow on its letters, over floating islands under an aurora." },
];

// Releases and announcements, newest first. Every row links to the thing itself.
const news = [
  { date: "2026-11-12", what: "NeoSkript enters public beta with 0.1.0-beta.1.", href: "https://github.com/xena-studios/neoskript/releases/tag/v0.1.0-beta.1", link: "Release notes" },
  { date: "2026-11-12", what: "Airfields, a winter sky-mining PvP server, is announced.", href: "https://airfieldsmc.com/news/airfields-is-coming", link: "Announcement" },
  { date: "2026-11-10", what: "Raptor 0.15.0 is out.", href: "https://github.com/xena-studios/raptor/releases/tag/v0.15.0", link: "Release notes" },
  { date: "2026-10-22", what: "xLimbo 2.0.0 and zChat 3.0.0 are out.", href: "https://modrinth.com/organization/xena-studios", link: "Modrinth" },
];

const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <h1 id="hero-title">Game servers, and the tools to run them.</h1>
      <p class="lead">
        Xena Studios makes the software that runs game servers on machines you own, the Minecraft plugins that run on
        them, and Minecraft servers of our own to play on.
      </p>
      <p class="actions">
        <a class="button primary" href="/tools">Tools for server owners</a>
        <a class="button" href="/servers">Servers to play on</a>
      </p>
      <ul class="marks" aria-label="What we make">
        {
          marks.map((m) => (
            <li>
              <a href={m.href}>
                <Image src={m.icon} alt="" widths={[64, 128]} sizes="2.5rem" />
                <span>{m.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <Horizon class="horizon" idPrefix="hero" />
  </section>

  <section class="paths" aria-label="Tools and servers">
    <div class="wrap paths-grid">
      <article class="path tools" aria-labelledby="tools-title">
        <div class="path-copy">
          <h2 id="tools-title">For the people who run servers</h2>
          <p class="lead">Open-source software for hosting game servers on your own hardware, and the plugins that run on them.</p>
          <ul class="path-list">
            {
              tools.map((t) => (
                <li>
                  <a href={t.href}>{t.name}</a>
                  <span>{t.what}</span>
                </li>
              ))
            }
          </ul>
          <a class="more" href="/tools">See the tools</a>
        </div>
        <figure class="path-art shot">
          <Image
            src={consoleShot}
            alt="Raptor's page for a Paper server: running, with its resource readouts above a live console."
            widths={[640, 960, 1280]}
            sizes="(min-width: 64rem) 36rem, 100vw"
            loading="lazy"
          />
        </figure>
      </article>

      <article class="path servers" aria-labelledby="servers-title">
        <div class="path-copy">
          <h2 id="servers-title">For the people who play</h2>
          <p class="lead">Our own Minecraft servers, for Java and Bedrock. Both are in development.</p>
          <a class="more" href="/servers">See the servers</a>
        </div>
        <ul class="server-art">
          {
            servers.map((s) => (
              <li>
                <a href={s.href}>
                  <Image src={s.art} alt={s.alt} widths={[640, 960, 1280]} sizes="(min-width: 82rem) 36rem, (min-width: 44rem) 50vw, 100vw" loading="lazy" />
                  <span class="server-name">{s.name}</span>
                  <span class="server-what">{s.what}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="news section" aria-labelledby="news-title">
    <div class="wrap">
      <h2 id="news-title">Lately</h2>
      <ol class="news-list">
        {
          news.map((n) => (
            <li>
              <time datetime={n.date} class="label">{longDate(n.date)}</time>
              <p>{n.what}</p>
              <a href={n.href}><External>{n.link}</External></a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Principles more={{ href: "/about", text: "More about the studio" }} />

  <ContactCta id="contact" idPrefix="home-cta" />
</Base>

<style>
  /* ---------------------------------------------------------------- hero */

  .hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-copy {
    align-self: center;
    padding-block: var(--s-8) clamp(12rem, 30svh, 20rem);
  }

  .hero h1 {
    max-width: 16ch;
    font-size: clamp(2rem, 1.1rem + 4.6vw, 5.25rem);
    line-height: 1.02;
  }

  .hero :global(.horizon) {
    position: absolute;
    inset: auto 0 0 0;
    z-index: -1;
    width: 100%;
    height: clamp(16rem, 52svh, 34rem);
    animation: rise 1800ms var(--ease) both;
  }

  .hero-copy > * {
    animation: settle 1000ms var(--ease) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 90ms;
  }

  .hero-copy > :nth-child(n + 3) {
    animation-delay: 180ms;
  }

  @keyframes rise {
    from {
      transform: translateY(14%);
      opacity: 0.2;
    }
  }

  @keyframes settle {
    from {
      transform: translateY(0.75rem);
      opacity: 0;
    }
  }

  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    margin: var(--s-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .marks a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-small);
    color: var(--muted);
    text-decoration: none;
  }

  .marks a:hover {
    color: var(--text);
  }

  .marks :global(img) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9px;
    transition: transform 200ms var(--ease);
  }

  .marks a:hover :global(img) {
    transform: translateY(-2px);
  }

  /* ---------------------------------------------------------------- paths */

  .paths {
    padding-block: var(--s-8);
  }

  .paths-grid {
    display: grid;
    gap: var(--s-5);
  }

  .path {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7);
    align-items: center;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--raised) 80%, transparent);
  }

  .path h2 {
    font-size: var(--t-h2);
  }

  .path-list {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .path-list li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .path-list a {
    font-weight: 600;
    text-decoration: none;
  }

  .path-list a:hover {
    color: var(--accent);
  }

  .path-list span {
    font-size: var(--t-small);
    color: var(--muted);
  }

  .shot {
    margin: 0;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: left top;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    -webkit-mask-image: linear-gradient(to bottom, var(--bg) 70%, transparent);
    mask-image: linear-gradient(to bottom, var(--bg) 70%, transparent);
  }

  .server-art {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .server-art a {
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
  }

  .server-art :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    margin-bottom: var(--s-3);
    transition:
      transform 600ms var(--ease),
      border-color 200ms var(--ease);
  }

  .server-art a:hover :global(img) {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--accent) 45%, var(--rule));
  }

  .server-name {
    font-weight: 600;
  }

  .server-what {
    font-size: var(--t-small);
    color: var(--muted);
  }

  /* The servers lead with their art: the copy on top, the two key arts wide below. */
  .path.servers {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }

  .path.servers .path-copy {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-2) var(--s-7);
    align-items: end;
  }

  .path.servers .path-copy .lead {
    margin-top: 0;
  }

  .path.servers .more {
    grid-column: 1;
    margin-top: var(--s-2);
  }

  @media (max-width: 44rem) {
    .server-art {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 64rem) {
    .path.servers .path-copy {
      grid-template-columns: minmax(0, 1fr);
    }

    .path {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }

  /* ---------------------------------------------------------------- news */

  .news-list {
    margin: var(--s-7) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .news-list li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .news-list a {
    font-size: var(--t-small);
    white-space: nowrap;
  }

  @media (max-width: 44rem) {
    .news-list li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
