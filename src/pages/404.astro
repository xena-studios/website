---
import Base from "../layouts/Base.astro";
import Horizon from "../components/Horizon.astro";
---
<Base title="Page not found · Xena Studios" description="There's nothing at this address.">
  <section class="lost" aria-labelledby="lost-title">
    <div class="wrap copy">
      <h1 id="lost-title">Nothing out here.</h1>
      <p class="lead">Error 404: this page doesn't exist, or it moved. The home page is a short trip back.</p>
      <p><a class="back" href="/">Back to xenastudios.co</a></p>
    </div>
    <Horizon class="horizon" />
  </section>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    min-height: calc(100svh - 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .copy {
    align-self: center;
    padding-block: var(--s-8) clamp(10rem, 28svh, 18rem);
  }

  h1 {
    font-size: var(--t-h1);
  }

  .lead {
    max-width: var(--measure);
    margin-top: var(--s-5);
    font-size: var(--t-lead);
    color: var(--muted);
  }

  .back {
    display: inline-block;
    margin-top: var(--s-6);
    color: var(--accent);
  }

  .lost :global(.horizon) {
    position: absolute;
    inset: auto 0 0 0;
    z-index: -1;
    width: 100%;
    height: clamp(14rem, 45svh, 30rem);
  }
</style>
