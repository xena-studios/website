---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import External from "../components/External.astro";
import fontLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Xena Studios: game server infrastructure, built in the open",
  description = "Xena Studios builds open-source software for running game servers on machines you own: Raptor, NeoSkript, and Minecraft plugins.",
} = Astro.props;

// build.format "file" makes the pathname /index.html or /<page>.html; the
// canonical address has neither, matching the sitemap and trailingSlash "never".
const path = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(path, Astro.site);
const og = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#06080D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xena Studios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="XENA STUDIOS over a planet horizon: game server infrastructure, built in the open." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="home" href="/" aria-label="Xena Studios, home">
          <Logo class="logo" />
        </a>
        <nav aria-label="Main">
          <ul>
            <li><a href="/#raptor">Raptor</a></li>
            <li class="optional"><a href="/#neoskript">NeoSkript</a></li>
            <li><a href="/#plugins">Plugins</a></li>
            <li class="optional"><a href="/#how-we-work">How we work</a></li>
            <li><a href="/#contact">Contact</a></li>
            <li><a href="https://github.com/xena-studios" rel="me">GitHub<External /></a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <Logo name="xena" class="foot-logo" />
        <p class="label">© {year} Xena Studios</p>
        <ul class="foot-links">
          <li><a href="https://raptorpanel.net">raptorpanel.net</a></li>
          <li><a href="https://docs.xenastudios.co">Plugin docs</a></li>
          <li><a href="https://modrinth.com/organization/xena-studios">Modrinth</a></li>
          <li><a href="https://github.com/xena-studios">GitHub</a></li>
          <li><a href="https://github.com/xena-studios/website">This site's source</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4rem;
  }

  .home {
    display: block;
    color: var(--text);
    padding-block: var(--s-3);
  }

  .home :global(.logo) {
    height: 0.8125rem;
    width: auto;
  }

  nav ul {
    display: flex;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
  }

  nav a {
    display: inline-block;
    padding-block: var(--s-2);
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .optional {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .home :global(.logo) {
      height: 0.6875rem;
    }

    nav ul {
      gap: var(--s-3);
      font-size: var(--t-label);
    }
  }

  .site-footer {
    padding-block: var(--s-6) var(--s-7);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }

  .foot :global(.foot-logo) {
    height: 0.75rem;
    width: auto;
    color: var(--text);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
  }

  .foot-links a {
    color: var(--muted);
  }

  .foot-links a:hover {
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .foot-links {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
